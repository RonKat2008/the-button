# Address of your deployed `button` contract
VITE_CONTRACT_ADDRESS=
# Which network the contract lives on: "sepolia" or "anvil" (local)
VITE_CHAIN=sepolia
# Optional: custom RPC URL (defaults to the chain's public RPC)
VITE_RPC_URL=
# Free id from https://cloud.reown.com — needed for WalletConnect (browser wallets work without it)
VITE_WALLETCONNECT_PROJECT_ID=
